  {
    "context": "VimControl && vim_mode == normal",
    "bindings": {
      "Z Z": "workspace::CloseProject",

      "] ]": "vim::NextMethodStart",
      "[ [": "vim::PreviousMethodStart",

      "space v t": "terminal_panel::Toggle",
      "space v s": "outline::Toggle",

      // Collapse different regions
      "z c": "editor::ToggleFold",
      "z o": "editor::ToggleFold",
      "z m": "editor::FoldAll",
      "z r": "editor::UnfoldAll",
      // map zc <Action>(CollapseRegion)
      // map zo <Action>(ExpandRegion)
      // map zm <Action>(CollapseAllRegions)
      // map zr <Action>(ExpandAllRegions)

      "space f w": "pane::DeploySearch",
      "space f f": "file_finder::Toggle",

      // Split and Split Navigation
      "space s v": "pane::SplitVertical",
      "space s h": "pane::SplitHorizontal",
      "space s x": "pane::CloseActiveItem",
      "space s s": "pane::CloseAllItems",
      "space s m": "vim::MaximizePane",

      "space w h": "workspace::ActivatePaneLeft",
      "space w l": "workspace::ActivatePaneRight",
      "space w j": "workspace::ActivatePaneDown",
      "space w k": "workspace::ActivatePaneUp",

      // "space w": "pane::CloseActiveItem",
