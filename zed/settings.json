// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "disable_ai": true,
  "edit_predictions": {
    "provider": "zed",
  },
  "colorize_brackets": true,
  "use_system_window_tabs": true,
  "rounded_selection": true,
  "lsp_document_colors": "inlay",
  "inline_code_actions": false,
  "minimap": {
    "show": "never",
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_branch_icon": true,
    "show_project_items": false,
  },
  "search": {
    "button": false,
    "case_sensitive": true,
    "center_on_match": true,
  },
  "project_panel": {
    "starts_open": false,
    "sticky_scroll": true,
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "dock": "left",
  },
  "icon_theme": "Catppuccin Mocha",
  "sticky_scroll": {
    "enabled": true,
  },
  "scrollbar": {
    "show": "never",
  },
  "terminal": {
    "keep_selection_on_copy": false,
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false,
  },
  "base_keymap": "JetBrains",
  "theme": "Catppuccin Mocha",
  "theme_overrides": {
    "Catppuccin Mocha": {
      "border.variant": "#15141C",
      "border": "#15141C",
      "title_bar.background": "#15141C",
      "panel.background": "#15141C",
      "panel.focused_border": "#4E466E",
    },
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "vim_mode": true,
  "ui_font_size": 13,
  "buffer_font_size": 13,
  "buffer_font_family": "JetBrains Mono",
  "buffer_line_height": {
    "custom": 1.5,
  },
  "ui_font_family": ".SystemUIFont",
  "hide_mouse": "on_typing_and_movement",
  "relative_line_numbers": "enabled",
  // allow cursor to reach edges of screen
  "vertical_scroll_margin": 8,
  "show_whitespaces": "none",
  "tab_bar": {
    "show": false,
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true,
  },
  "preview_tabs": {
    "enable_preview_from_project_panel": true,
    "enable_preview_from_file_finder": false,
    "enable_preview_from_multibuffer": false,
    "enable_preview_multibuffer_from_code_navigation": false,
    "enable_preview_file_from_code_navigation": false,
  },
  // Git gutter behavior configuration.
  "git": {
    "git_gutter": "tracked_files",
    // Control whether the git blame information is shown inline,
    // in the currently focused line.
    "inline_blame": {
      "enabled": false,
      // Sets a delay after which the inline blame information is shown.
      // Delay is restarted with every cursor movement.
      // "delay_ms": 600
    },
  },
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": false,
    // NOTE: This might change in the future.
    "experimental.show": true,
  },
  "vim": {
    "use_system_clipboard": "never",
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "gutter": {
    "min_line_number_digits": 0,
  },
  "wrap_guides": [120],
  "show_wrap_guides": true,
  "completion_menu_scrollbar": "auto",
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "seed_search_query_from_cursor": "never",
}
